# 阿里云 DashScope API Key (用于通义千问等模型)
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 阿里云 Access Key (用于 OSS、视频超分等服务)
ALIBABA_CLOUD_ACCESS_KEY_ID=your_aliyun_access_key_id_here
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your_aliyun_access_key_secret_here

# OSS 配置 (可选，用于图片/视频存储)
OSS_BUCKET_NAME=your_bucket_name
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BASE_PATH=comic_gen/

# Kling AI 配置 (可选，用于 Kling 视频生成)
KLING_ACCESS_KEY=your_kling_access_key_here
KLING_SECRET_KEY=your_kling_secret_key_here

# Vidu AI 配置 (可选，用于 Vidu 视频生成)
VIDU_API_KEY=your_vidu_api_key_here

# MuleRun / MuleRouter 配置 (可选，用于 Seedance 2.0 视频生成 + GPT-Image-2 图片生成)
# 方式一 (推荐): 安装 MuleRun CLI 并登录，然后从 mulerun studio config 获取 key
#   npm i -g @mulerunai/cli && mulerun login
#   mulerun studio config  → 复制 API Key (格式: muk-...)
# 方式二: 直接用 MuleRouter API Key
# 两种 key 格式通用，填入同一变量即可：
# MULEROUTER_API_KEY=muk-your-key-here
# 站点选择 (mulerouter=默认, mulerun=更多模型但 gpt-image-2 仅 mulerouter 可用)
# MULEROUTER_SITE=mulerouter

# Agnes AI 配置 (可选，OpenAI 兼容聚合商：文本 + 图像 + 视频生成，一个 Key 共用)
# 平台: https://platform.agnes-ai.cn  (API 网关: https://apihub.agnes-ai.com)
# 模型名以 "agnes" 开头时路由到 Agnes（如 agnes-image-2.0-flash / agnes-video-2.5-i2v）
# AGNES_API_KEY=your_agnes_api_key_here
# AGNES_BASE_URL=https://apihub.agnes-ai.com
# AGNES_MODEL=agnes-2.5-pro-beta
# AGNES_IMAGE_MODEL=agnes-image-2.0-flash
# AGNES_VIDEO_MODEL=agnes-video-2.5

# LLM 多模型适配 (可选)
# 默认使用 DashScope (通过 OpenAI 兼容接口调用，只需上方 DASHSCOPE_API_KEY 即可)
# LLM_PROVIDER=dashscope
#
# 如需切换到第三方 OpenAI 兼容 API (OpenAI/DeepSeek/Ollama 等):
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
#
# DeepSeek 示例:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_deepseek_api_key
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat
#
# 本地 Ollama 示例:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen2.5:72b
#
# Agnes AI 文本模型示例 (大纲/分镜脚本走 Agnes，需上方 AGNES_API_KEY):
# LLM_PROVIDER=agnes
# AGNES_MODEL=agnes-2.5-pro-beta

# 本地 ComfyUI 配置 (可选，本地生图，无需 API Key)
# 模型名以 "comfyui" 开头时路由到本地 ComfyUI（如 comfyui-flux2）
# COMFYUI_BASE_URL=http://127.0.0.1:8188
# 内置 SD checkpoint 生图/I2I 工作流所需 checkpoint 名（ComfyUI models/checkpoints 下的文件名）
# COMFYUI_CHECKPOINT=flux2-dev.safetensors
# 自定义 API-format 工作流 JSON 模板（支持 {{PROMPT}}/{{NEGATIVE_PROMPT}}/{{WIDTH}}/{{HEIGHT}}/{{SEED}}/{{CHECKPOINT}}/{{IMAGE_N}} 占位符）
# COMFYUI_WORKFLOW_IMAGE=D:/workflows/image_flux2_api.json
# COMFYUI_WORKFLOW_I2I=D:/workflows/image_flux2_i2i_api.json
# 出图轮询超时（秒）
# COMFYUI_TIMEOUT=600

# API 服务配置
API_HOST=0.0.0.0
API_PORT=8000

# ===============================
# API 端点配置 (可选，海外部署时切换到国际端点)
# 命名约定: {PROVIDER}_BASE_URL
# ===============================
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com
# KLING_BASE_URL=https://api.klingai.com/v1
# VIDU_BASE_URL=https://api.vidu.cn/ent/v2
# MULEROUTER_BASE_URL=https://api.mulerouter.ai
# AGNES_BASE_URL=https://apihub.agnes-ai.com
